diff --git a/wled00/wled_serial.cpp b/wled00/wled_serial.cpp
index dd04788..42e66c4 100644
--- a/wled00/wled_serial.cpp
+++ b/wled00/wled_serial.cpp
@@ -30,4 +30,8 @@ void updateBaudRate(uint32_t rate){
   unsigned rate100 = rate/100;
   if (rate100 == currentBaud || rate100 < 96) return;
+  #ifdef WLED_USE_ETHERNET_SPI
+  // the W5500 RST/INT lines can sit on the UART0 pins: Serial.begin() would take them back
+  if (PinManager::getPinOwner(hardwareRX) == PinOwner::Ethernet || PinManager::getPinOwner(hardwareTX) == PinOwner::Ethernet) return;
+  #endif
   currentBaud = rate100;
 
