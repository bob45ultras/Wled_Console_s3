--- a/wled00/wled_ethernet.h
+++ b/wled00/wled_ethernet.h
@@ -6,4 +6,13 @@
 #ifdef WLED_USE_ETHERNET
 
+#ifdef WLED_USE_ETHERNET_SPI
+// SPI Ethernet (W5500): implemented in eth_w5500.cpp. The pins come from the build flags
+// WLED_W5500_SCLK / MOSI / MISO / CS / INT / RST, so there is no board table here.
+// The "reserved pins" list holds the six pins used by the module, in this order:
+// SCLK, MOSI, MISO, CS, INT (CS again when INT is not used), RST.
+#define WLED_ETH_RSVD_PINS_COUNT 6
+extern const managed_pin_type esp32_nonconfigurable_ethernet_pins[WLED_ETH_RSVD_PINS_COUNT];
+#else
+
 // For ESP32, the remaining five pins are at least somewhat configurable.
 // eth_address  is in range [0..31], indicates which PHY (MAC?) address should be allocated to the interface
@@ -31,5 +40,7 @@ extern const ethernet_settings ethernetBoards[];
 #define WLED_ETH_RSVD_PINS_COUNT 6
 extern const managed_pin_type esp32_nonconfigurable_ethernet_pins[WLED_ETH_RSVD_PINS_COUNT];
-#endif
+#endif // WLED_USE_ETHERNET_SPI
+
+#endif // WLED_USE_ETHERNET
 
 #endif
